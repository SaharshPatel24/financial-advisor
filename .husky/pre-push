#!/bin/sh

echo "🔨 Building API..."
npm run build --workspace=apps/api || {
  echo ""
  echo "❌ API build failed. Fix the errors before pushing."
  echo ""
  exit 1
}

echo "🔍 Type-checking mobile..."
npm run typecheck --workspace=apps/mobile || {
  echo ""
  echo "❌ Mobile type-check failed. Fix the errors before pushing."
  echo ""
  exit 1
}

echo "✅ All checks passed."
